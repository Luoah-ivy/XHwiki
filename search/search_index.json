{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6b22\u8fce\u6765\u5230\u661f\u6d77wiki\uff01","text":""},{"location":"Home/introduction/","title":"\u6b22\u8fce\u6765\u5230\u661f\u6d77wiki\uff01","text":"<p>XHwiki\uff0c\u5373\u661f\u6d77wiki\uff0c\u662f\u7531Luoah\u5236\u4f5c\u7684wiki\u7f51\u7ad9\u3002 \u8fd9\u91cc\u6536\u5f55\u5357\u4eac\u90d1\u548c\u5916\u56fd\u8bed\u5b66\u6821\u661f\u6d77\u73ed(\u53732025\u7ea72\u73ed)\u7684\u5404\u79cd\u6897\u77e5\u8bc6\u3001\u4eba\u7269\u3001 \u4ee5\u53ca\u5404\u79cd\u8bed\u5f55\u2026\u2026</p>"},{"location":"Home/introduction/#_1","title":"\u5236\u4f5c\u56e2\u961f","text":"<p>\u4ee3\u7801\uff1aLuoah</p> <p>\u6587\u672c\uff1aLuoah</p> <p>\u7f8e\u5de5\uff1aLuoah</p> <p>\u8fd0\u8425\uff1aLuoah</p> <p>\u53d1\u884c\uff1aLuoah</p> <p>\u5ba3\u4f20\uff1aLuoah</p> <p>\u601d\u8def\uff1aLuoah</p> <p>Luoah\u771f\u662f\u592a\u5f3a\u4e86\uff01</p>"},{"location":"Home/introduction/#_2","title":"\u8054\u7cfb\u6211\u4eec","text":"<p>\u5982\u679c\u60a8\u6709\u5408\u7406\u7684\u610f\u89c1\uff0c\u6211\u4eec\u975e\u5e38\u6b22\u8fce\u60a8\u4e3a\u6211\u4eecXHwiki\u7684\u53d1\u5c55\u5efa\u8a00\u732e\u7b56\u3002</p> <p>\u5f53\u7136\uff0c\u60a8\u4e5f\u53ef\u4ee5\u5927\u80c6\u63d0\u51fa\u4e0d\u5408\u7406\u7684\u95ee\u9898\uff0c\u8fd9\u6837\u60a8\u5c31\u53ef\u4ee5\u51fa\u73b0\u5728Luoah\u7684\u9ed1\u540d\u5355\u4e2d\u540d\u5782\u6d45\u5c4e\uff0c\u5e76\u4e14Luoah\u4e5f\u4e0d\u4f1a\u6539\u3002</p> <p>\u5982\u679c\u60a8\u63d0\u51fa\u7684\u610f\u89c1\u8db3\u591f\u6709\u4ef7\u503c\u3001\u6709\u610f\u4e49\uff0c\u6211\u4eec\u7684\u56e2\u961f\u5c06\u975e\u5e38\u6b22\u8fce\u60a8\u7684\u52a0\u5165\uff01</p> <p></p> <p>\u9644\uff1a\u82e5\u8981\u8054\u7cfbLuoah\uff0c\u8bf7\u6253\u5f00Luoah\u7684\u4ecb\u7ecd\u4ee5\u67e5\u770b\u3002</p> <p>\u6ce8\uff1aXHwiki Team QQ\u7fa4\u5df2\u7981\u6b62\u901a\u8fc7\u641c\u7d22\u7fa4\u53f7\u6dfb\u52a0\uff0c\u5982\u6709\u7279\u522b\u60c5\u51b5\uff0c\u8bf7\u626b\u63cf\u4e8c\u7ef4\u7801\u6dfb\u52a0\u3002</p>"},{"location":"Home/introduction/#_3","title":"\u81f4\u8c22","text":"<p>\u611f\u8c22Henson\u63d0\u4f9b\u90e8\u5206\u7075\u611f\u4e0e\u601d\u8def\u652f\u6301\u3002</p> <p>\u611f\u8c22Henson\u3001Milson\u3001\u54cd\u5f7b\u672a\u6765\u3001Goldenfish\u53c2\u4e0e\u516c\u6d4b\u5e76\u63d0\u4f9b\u610f\u89c1\u3002</p> <p>\u611f\u8c22lris\u5728\u6211\u7684\u521b\u4f5c\u9014\u4e2d\u7ed9\u4e88\u6211\u7684\u6fc0\u52b1\u4e0e\u652f\u6301\u3002</p> <p>\u611f\u8c22Bilibili 8047-\u7684\u6559\u5b66\u3002</p> <p>\u611f\u8c22Github\u63d0\u4f9b\u7684\u4e91\u5b58\u50a8\u4e0e\u670d\u52a1\u5668\u652f\u6301\u3002</p> <p>\u611f\u8c22mkdocs\u7684wiki\u6a21\u677f\u3002</p>"},{"location":"Meme/Bro/","title":"\u597d\u5144\u5f1f\u4e00\u8f88\u5b50","text":"<p>\u4e00\u822c\u4e0d\u4f7f\u7528\uff0c\u7279\u522b\u60c5\u51b5\u4e0b\u7528\u4e8e\u8c03\u4f83\u5144\u5f1f\u4e24\u4eba\u90fd\u4e0d\u592a\u806a\u660e\uff0c\u6781\u5c11\u60c5\u51b5\u4e0b\u8bf4\u4e24\u4eba\u90fd\u5f88\u806a\u660e\u3002</p> <p>\u4e00\u822c\u6307\u91d1\u4ed5\u6770\u548c\u9648\u5b87\u5b81\u3002</p>"},{"location":"Meme/Bro/#_2","title":"\u539f\u4e49","text":"<p>\u521a\u5f00\u5b66\u7684\u65f6\u5019\uff0c\u6709\u4e00\u90e8\u5206\u540c\u5b66\u8ba4\u4e3a\u91d1\u4ed5\u6770\u548c\u9648\u5b87\u5b81\u957f\u5f97\u50cf\u5144\u5f1f\uff08Luoah\u5e76\u4e0d\u8fd9\u4e48\u8ba4\u4e3a\uff09\uff0c \u7136\u800c\u91d1\u4ed5\u6770\u548c\u9648\u5b87\u5b81\u786e\u5b9e\u662f\u4e00\u4e2a\u5c0f\u5b66\u7684\uff08\u4e0d\u662f\u4e00\u4e2a\u73ed\uff09\uff0c\u5f80\u540e\u7684\u79cd\u79cd\u8ff9\u8c61\u8868\u660e\uff0c\u8fd9\u4fe9\u4eba\u8fd8\u771f\u6709\u53ef\u80fd\u662f\u5f02\u7236\u5f02\u6bcd\u7684\u5144\u5f1f\u3002</p> <p>\u6bd4\u5982\uff0c\u5728\u4e00\u573a\u8bf8\u795e\u9ec4\u660f\u7684\u6570\u5b66\u8003\u8bd5\u4e2d\uff0c\u91d1\u4ed5\u6770\u4e0e\u9648\u5b87\u5b81\u5e76\u5217\u7b2c\u4e00\uff0c\u7136\u800c\u4ed6\u4eec\u7adf\u7136\u9519\u5f97\u90fd\u4e00\u6837\u3002</p> <p>Luoah\u548cMilson\u5e76\u6ca1\u6709\u4e92\u6284\u3002</p> <p> </p> <p>\u518d\u6bd4\u5982\uff0cLuoah\u548cMilson\u5728\u90fd\u6ca1\u6709\u590d\u4e60\u7684\u60c5\u51b5\u4e0b\uff0c\u5728\u82f1\u8bed\u9ed8\u5199\u7ade\u8d5b\u4e2d\u53cc\u53cc\u53d6\u5f9754\u7684\u9ad8\u5206\u3002\uff08\u55ef\u5bf9\uff09</p> <p>\u4e24\u4eba\u4e0d\u7981\u611f\u53f9\uff1a\u597d\u5144\u5f1f\uff0c\u4e00\u8f88\u5b50\uff01</p>"},{"location":"Meme/Bro/#_3","title":"\u5f15\u7533\u4e49","text":"<p>\u6307\u4e24\u4e2a\u8001\u50bb\u5b50\u3002</p> <p>\u55ef\u5bf9\uff0c\u4f60\u53ef\u4ee5\u8fd9\u4e48\u7406\u89e3\u3002</p>"},{"location":"Meme/DLL528/","title":"5.28\u4e16\u754c\u4e0a\u4f1a\u6709\u4e00\u4e2a\u975e\u5e38\u975e\u5e38\u5e78\u798f\u7684\u5973\u5b69","text":"<p>\u8fd9\u662f\u4e00\u4e2a\u60b2\u4f24\u7684\u6545\u4e8b\uff0c\u5982\u679c\u88abLuoah\u53d1\u73b0\u4f60\u628a\u8fd9\u4ef6\u4e8b\u544a\u8bc9DLL\uff0cLuoah\u5c06\u4f1a\u8bf7\u4f60\u5403\u597d\u5403\u7684\u4e1c\u897f\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u5929\u7167\u3001\u706b\u9041\u00b7\u8c6a\u706b\u7403\u4e4b\u672f\u3001\u7206\u98ce\u4e71\u821e\u3001\u6c34\u9041\u00b7\u5927\u9c9b\u5f39\u4e4b\u672f\u3001\u6c34\u9f99\u5f39\u4e4b\u672f\u3001\u98ce\u9041\u00b7\u87ba\u65cb\u624b\u91cc\u5251\u3001\u96f7\u9041\u00b7\u96f7\u5207\u3001\u5343\u9e1f\u3001\u9e92\u9e9f\u3001\u571f\u9041\u00b7\u571f\u6d41\u58c1\u3001\u8f7b\u91cd\u5ca9\u4e4b\u672f\u3001\u51b0\u9041\u00b7\u9b54\u955c\u51b0\u6676\u3001\u6eb6\u9041\u200c\u3001\u6728\u9041\u00b7\u6811\u754c\u964d\u8bde\u200c\u3001\u5c18\u9041\u00b7\u539f\u754c\u5265\u79bb\u4e4b\u672f\u3001\u795e\u5a01\u3001\u522b\u5929\u795e\u3001\u987b\u4f50\u80fd\u4e4e\u3001\u5929\u4e4b\u5fa1\u4e2d\u200c\u3001\u5929\u624b\u529b\u3001\u4ed9\u6cd5\u00b7\u87ba\u65cb\u4e38\u200c\u3001\u4ed9\u6cd5\u00b7\u4e94\u53f3\u536b\u95e8\u3001\u98de\u96f7\u795e\u4e4b\u672f\u3001\u79fd\u571f\u8f6c\u751f\u3001\u79fd\u571f\u8f6c\u751f\u3001\u516b\u95e8\u9041\u7532\u3001\u591c\u51ef\u2026\u2026</p> <p>\u4f60\u80fd\u770b\u5230\u8fd9\u4e2a\u6545\u4e8b\uff0c\u5e94\u8be5\u5148\u8d5e\u53f9Luoah\u7adf\u7136\u628a\u8fd9\u4e48\u7f9e\u803b\u7684\u4e1c\u897f\u5199\u8fdb\u4e86Wiki(\u7981\u6b62\u548c\u5176\u4ed6\u540c\u5b66\u5206\u4eab\u8fd9\u4e2a\u60b2\u4f24\u7684\u6545\u4e8b)\u3002</p>"},{"location":"Meme/DLL528/#_1","title":"\u539f\u4e49","text":"<p>\u8d77\u56e0\u662fDLL\u7684\u751f\u65e5\u662f5.29\uff0c\u4e3a\u4ec0\u4e48Luoah\u4f1a\u77e5\u9053\u5462\uff1f\u8bf7\u770b\u4e0b\u56fe\uff1a</p> <p></p> <p>\u8fd9\u662f\u5565\u65f6\u5019\u7684\u4e86\uff1f\u5bb6\u8054\u672c78\u5e74\u6ca1\u7ed9\u8001\u5e08\u770b\u4e86\u3002 \u2014\u2014\u54cd\u5f7b\u672a\u6765</p> <p>\u5176\u5b9e\u8fd9\u662f\u521a\u5f00\u5b66\u4e0d\u4e45\u7684\u5bb6\u8054\u672c\uff0c\u8d77\u56e0\u662fLuoah\u5047\u671f\u5728\u5357\u5916\u5199\u9898\u4f11\u606f\u7684\u65f6\u95f4\u770b\u5230\u4e86\u9ad8\u4e2d\u751f\u7ed9\u73ed\u4e3b\u4efb\u8fc7\u751f\u65e5\u7684\u89c6\u9891\uff0c \u4e8e\u662f\u5fc3\u8840\u6765\u6f6e\u51b3\u5b9a\u7ed9\u81ea\u5df1\u672a\u6765\u7684\u73ed\u4e3b\u4efb\u4e5f\u641e\u4e00\u4e2a\uff0c\u6ca1\u60f3\u5230\u81ea\u5df1\u672a\u6765\u7684\u73ed\u4e3b\u4efb\u8fd9\u4e48\u597d\uff0c\u4e8e\u662fLuoah\u63d0\u524d\u597d\u51e0\u4e2a\u6708\u5c31\u5f00\u59cb\u51c6\u5907\u4e86\uff0c \u4f46\u662f\u5c31\u5728DLL\u751f\u65e5\u5373\u5c06\u6765\u4e34\u7684\u65f6\u5019\uff0c\u667a\u969cLuoah\u5f15\u8d77\u4e86\u4e00\u573a\u60b2\u4f24\u7684\u6545\u4e8b\u3002</p> <p>Luoah\u5efa\u4e86\u4e00\u4e2a\u540d\u53ebSurprise\u7684\u7fa4\uff0c\u548c\u670b\u53cb\u4e00\u8d77\u5546\u8ba8\u600e\u4e48\u7ed9DLL\u60ca\u559c\u3002 \u7136\u800c\u8bb0\u5fc6\u529b\u8d85\u7fa4\u7684Luoah\u628aDLL\u751f\u65e5\u8bb0\u6210\u4e865.28\uff0c\u51c6\u5907\u57285.28\u628a\u51c6\u5907\u7684\u793c\u7269\u5e26\u5230\u5b66\u6821\u3002</p> <p>\uff08\u4f60\u77e5\u9053\u7684\u592a\u591a\u4e86\uff09\u56e0\u4e3aLuoah\u60f3\u88c513\uff0c\u56e0\u6b64Luoah\u53d1\u4e86\u4e2a\u670b\u53cb\u5708\u3002</p> <p></p> <p>5.26\uff0cLuoah\u53d1\u4e86\u4e2a\u670b\u53cb\u5708\uff0c\u662fLuoah\u7ed9DLL\u51c6\u5907\u7684\u793c\u7269(\u5927\u90e8\u5206\u4e3a\u534a\u6210\u54c1\uff0c\u548c\u51e0\u4e2a\u540c\u5b66\u4e00\u8d77\u5b8c\u6210\u7684\u8d3a\u5361\u7b49)\u3002 \u914d\u6587\u662f\u201c5.28 \u4e16\u754c\u4e0a\u4f1a\u6709\u4e00\u4e2a\u975e\u5e38\u975e\u5e38\u5e78\u798f\u7684\u5973\u5b69\u201d\uff0c\u65e8\u5728\u8868\u8fbeDLL\u5c06\u4f1a\u975e\u5e38\u5e78\u798f\u4ee5\u53ca\u5938DLL\u975e\u5e38\u5e74\u8f7b\uff0c \u7136\u800c\u5c31\u5728\u6b64\u65f6\uff0c\u806a\u660e\u7684Henson\u8d28\u7591\u201c\u8fd9\u5bf9\u4e48\u201d\uff1f\u5e76\u4e14\u4ed4\u7ec6\u5730\u67e5\u770b\u4e86DLL\u7684QQ\u4e3b\u9875\uff0c Luoah\u7ffb\u627e\u5bb6\u8054\u672c\u540e\u8bc1\u5b9e\u4e86\u8fd9\u4e00\u70b9\uff0cHenson\u518d\u4e00\u6b21\u6551Luoah\u4e8e\u6c34\u706b\u4e4b\u4e2d\uff0c\u6c34\u706b\u600e\u4e48\u6765\u7684\uff0c\u5443\uff0c\u4e0d\u8981\u5728\u610f\u8fd9\u4e9b\u5c0f\u7ec6\u8282\u3002</p>"},{"location":"Meme/DLL528/#_2","title":"\u63d0\u9192","text":"<p>\u6ca1\u6709\u5f15\u7533\u4e49\uff0c\u4f46\u662f\u4e0d\u8981\u968f\u4fbf\u73a9\u8fd9\u4e2a\u6897\uff0c\u4e14\u7edd\u5bf9\u4e0d\u8981\u5411\u4ed6\u4eba\u5206\u4eab\u8fd9\u4e2a\u5e76\u4e0d\u6709\u8da3\u7684\u6545\u4e8b\uff0c\u7279\u522b\u662f\u544a\u8bc9DLL\u3002</p> <p>\u5982\u679c\u4f60\u8fd9\u4e48\u505a\u4e86\uff0cLuoah\u4f1a\u5bf9\u4f60\u975e\u5e38\u53cb\u597d\uff0c\u6069\uff0c\u5bf9\u3002</p> <p>\u96441\uff1a\u4f60\u4e0d\u59a8\u5927\u80c6\u5c1d\u8bd5\uff0c\u4f46\u662f\u5982\u679cLuoah\u77e5\u9053\u4f60\u544a\u8bc9\u4e86DLL\uff0cLuoah\u5c06\u91cd\u62fe\u4ed6\u5728\u5357\u5916\u7684\u4e09\u5927\u53e3\u5934\u7985\u3002</p> <p>\uff08\u4f60\u77e5\u9053\u7684\u592a\u591a\u4e86\uff09\u4f60\u4e0d\u4f1a\u4ee5\u4e3a\u6211\u4f1a\u544a\u8bc9\u4f60Luoah\u4e09\u5927\u53e3\u5934\u7985\u5427\uff1f\u8fd9\u4e0d\u80fd\u8fc7\u5ba1\uff0c\u56e0\u6b64\u8fd9\u6b21\u4f60\u77e5\u9053\u7684\u771f\u7684\u592a\u591a\u4e86\u3002</p> <p>\u96442\uff1a\u4e0d\u8981\u544a\u8bc9DLL\u561b~\u597d\u4e0d\u597d\u561b~\u6c42\u6c42\u4f60\u5566~</p> <p>\u54ce\u6211\u64cd\u8fd9\u6bb5\u597d\u8be1\u5f02\u554a\uff0c\u4f60\u77e5\u9053\u7684\u592a\u591a\u4e86\u3002</p>"},{"location":"Meme/HDL/","title":"\u559d\u5927\u4e86","text":"<p>\u7528\u4e8e\u8c03\u4f83\u67d0\u4eba\u8bdd\u5bc6\uff0c\u5927\u8111\u5b95\u673a\u6216\u662f\u8bf4\u8bdd\u505a\u4e8b\u4e0d\u7740\u7406\u3002</p>"},{"location":"Meme/HDL/#_2","title":"\u539f\u4e49","text":"<p>\u56e0\u4e3a\u80e1\u8001\u5e08\u6bcf\u5929\u4e2d\u5348\u5927\u5bb6\u4e00\u8d77\u6765\u5c31\u8981\u603b\u7ed3\uff0c\u8bfe\u95f4\u65f6\u95f4\u672c\u6765\u5c31\u77ed\u8fd8\u8981\u603b\u7ed3\u4e94\u516d\u5206\u949f\uff0c\u4e8e\u662f\u6709\u4eba\u7528\u524d\u82f1\u8bed\u4e25\u8001\u5e08\u7684\u8bdd\u8c03\u4f83\u80e1\u8001\u5e08\u8bf4\uff1a\u80e1\u8001\u5e08\u662f\u4e0d\u662f\u559d\u5927\u4e86\u3002 \u7ed3\u679c\u8bb8\u591a\u4eba\u8ba4\u4e3a\u8fd9\u4e2a\u8bed\u8a00\u6bd4\u8f83\u597d\u7b11\uff0c\u4e8e\u662f\u5feb\u901f\u4f20\u64ad\u5f00\u6765\uff0c\u751a\u81f3\u5df2\u7ecf\u7528\u559d\u6c34\u7684\u624b\u52bf\u6765\u4ee3\u8868\u201c\u559d\u5927\u4e86\u201d\u3002</p> <p><code>\u597d\u50cf\u4e5f\u6ca1\u90a3\u4e48\u597d\u7b11\u3002</code></p> <p>Milson\u79d1\u666e\u5c0f\u77e5\u8bc6\uff1a</p> <p></p> <p>\u9644\uff1a\u7b80\u76f4\u662f\u65e0\u5fc3\u63d2\u67f3\u67f3\u6210\u836b\u3002</p>"},{"location":"Meme/HDL/#_3","title":"\u5f15\u7533\u4e49","text":"<p>\u56e0\u4e3a\u559d\u591a\u4e86\u4f1a\u505a\u51fa\u4e00\u4e9b\u5947\u602a\u7684\u4e8b\uff0c\u56e0\u6b64\u4e5f\u7528\u201c\u559d\u5927\u4e86\u201d\u6765\u4ee3\u8868\u67d0\u4eba\u8bf4\u8bdd\u6216\u505a\u4e8b\u4e0d\u7ecf\u601d\u8003\uff0c \u96be\u4ee5\u7406\u89e3\u3002</p> <p>\u540c\u65f6\uff0c\u4eba\u4eec\u4e5f\u7528\u201c\u80e1\u8001\u5e08\u8bf7\u4f60\u559d\u9152\u201d\u6765\u4ee3\u66ff\u201c\u73ed\u4e3b\u4efb\u8bf7\u4f60\u559d\u8336\u201d\u3002</p>"},{"location":"Meme/HDL/#_4","title":"\u53e0\u7532","text":"<p>\u672c\u6587\u4ec5\u5bf9\u8fd9\u4e2a\u6897\u7684\u89e3\u8bfb\uff0c\u65e0\u4efb\u4f55\u4e2a\u4eba\u60c5\u611f\u503e\u5411\u6216\u662f\u4e0d\u5c0a\u91cd\u8001\u5e08\uff0c\u6211\u5e76\u4e0d\u6e05\u695a\u662f\u8c01\u53d1\u660e\u4e86\u8fd9\u4e2a\u6897\uff0c\u540c\u65f6\u8fd9\u4e2a\u6897\u4ec5\u662f\u8bf4\u660e\u4e00\u79cd\u72b6\u6001\uff0c\u800c\u4e0d\u662f\u8bf4\u80e1\u8001\u5e08\u8bf4\u8bdd\u505a\u4e8b\u4e0d\u7740\u7406\uff0c\u80e1\u8001\u5e08\u662f\u975e\u5e38\u4f18\u79c0\u7684\u73ed\u4e3b\u4efb\u3002\u80e1\u8001\u5e08\u6211\u4e3a\u4f60\u70b9\u8d5e\uff01\u52a0\u6cb9\uff01</p> <p>\u540c\u65f6\u5728\u4f7f\u7528\u5e76\u4f20\u64ad\u8fd9\u4e2a\u6897\u65f6\uff0c\u6211\u5021\u8bae\u5408\u7406\u4f7f\u7528\uff0c\u4e0d\u80fd\u7528\u4e8e\u8d2c\u4f4e\u80e1\u8001\u5e08\uff0c\u5e72\u6270\u5f71\u54cd\u80e1\u8001\u5e08\u7684\u6b63\u5e38\u73ed\u4e3b\u4efb\u5de5\u4f5c\u3002</p>"},{"location":"Meme/SC/","title":"\u9178\u81ed","text":"<p>\u7528\u4e8e\u8c03\u4f83\u67d0\u4eba\u559c\u6b22show off(\u8bdd\u7cd9\u7406\u4e0d\u7cd9\u5c31\u662f\u7231\u88c5\u903c)\u3002</p>"},{"location":"Meme/SC/#_2","title":"\u539f\u4e49","text":"<p>\u6307\u5362\u6da6\u5764\u5728\u4e0a\u8bfe\u65f6\u5c61\u6b21show off\uff0c \u4e14\u5728\u83b7\u5f97\u6bcf\u5468\u4e4b\u661f\u540e\u7528\u6587\u8a00\u6587\u5199\u4e2a\u4eba\u4ecb\u7ecd\u7684\u884c\u4e3a\u592a\u8fc7\u5f20\u626c\uff0c \u4f7f\u4eba\u5fc3\u6001\u6709\u70b9\u9178\uff0c\u5bf9\u8fd9\u79cd\u884c\u4e3a\u55e4\u4e4b\u4ee5\u9f3b\u7684\u4e00\u4e9b\u5acc\u5f03\u4f7f\u7a7a\u6c14\u4e2d\u5f25\u6f2b\u7740\u4e00\u80a1\u9178\u81ed\u5473\u3002</p> <p>\u56e0\u4e3a\u9178\u81ed\u662f\u87ba\u86f3\u7c89\u7684\u4ee3\u540d\u8bcd\uff0c\u56e0\u6b64\u540e\u5f88\u5feb\u5f15\u7533\u51fa\u5362\u6da6\u5764\u7231\u55e6\u7c89\u7684\u6545\u4e8b\uff0c \u7136\u800c\u8fd8\u6709\u4e00\u4ef6\u9006\u5929\u7684\u6545\u4e8b\uff1a \u67d0\u4eba(\u53d6\u6635\u79f0\u9996\u5b57\u6bcd\u7b80\u79f0L)\u60f3\u8981\u6076\u641e\u5362\u6da6\u5764\uff0c\u4fbf\u548c\u4ed6\u8bf4\u8bf7\u4ed6\u5403\u87ba\u72ee\u7c89\uff0c \u4f46\u662f\u524d\u63d0\u662f\u5362\u6da6\u5764\u8981\u5bf9\u7740\u955c\u5934\u8bf4\u201c\u6211\u662f\u5362\u6da6\u5764\uff0c\u55e6\u7c89\u5566\uff01\u9178\u81ed\uff01\u201d L\u672c\u4ee5\u4e3a\u5362\u6da6\u5764\u8981\u62d2\u7edd\uff0c\u6ca1\u60f3\u5230\u5bf9\u65b9\u6beb\u4e0d\u72b9\u8c6b\u7b54\u5e94\uff0c\u5e76\u8bf7\u6c42\u5728\u66f4\u65e9\u7684\u8fd0\u52a8\u4f1a\u5c31\u8bf7\u4ed6\u5403\uff0c \u5927\u5927\u9707\u64bc\u4e86L\u5e7c\u5c0f\u7684\u5fc3\u7075\u3002</p>"},{"location":"Meme/SC/#_3","title":"\u5f15\u7533\u4e49","text":"<p>\u6307\u67d0\u4eba\u7231show off(\u4e00\u822c\u662f\u4e14\u8fd9\u4e2a\u4eba\u88c5\u7684\u8fc7\u4e8e\u5938\u5f20\u65f6)\u3002</p> <p>\u56e0\u4e3a\u4ee5\u524d\u82f1\u8bed\u8bfe\u4e0a\u5362\u6da6\u5764\u5929\u5929show off\uff0c\u73b0\u5728\u82f1\u8bed\u8bfe\u6362\u4e86\u80e1\u8001\u5e08\uff0c \u56e0\u6b64\u67d0\u540c\u5b66\u5c06\u8fd9\u4e24\u6897(\u53e6\u4e00\u6897\u8be6\u89c1\u559d\u5927\u4e86)\u7ec4\u5408\u5728\u4e00\u8d77\uff1a</p> <p>\u82f1\u8bed\u8bfe\u771f\u662f\u592a\u80a5\u7f8e\u4e86\uff0c\u4ee5\u524d\u55e6\u7c89\uff0c\u73b0\u5728\u559d\u9152\u3002</p>"},{"location":"Students/25/","title":"\u91d1\u4ed5\u6770","text":"<p>\u4e0d\u662f\u6211\u611f\u89c9\u6211\u600e\u4e48\u662f\u4e2a\u5510\u903c\u554a\u3002 \u2014\u2014\u91d1\u4ed5\u6770\u5bf9\u8fd9\u4e2a\u4eba\u7269\u7684\u8bc4\u4ef7</p> <p></p>"},{"location":"Students/25/#_2","title":"\u7b80\u4ecb","text":"<p>\u91d1\u4ed5\u6770(20250225)\uff0c\u6635\u79f0Luoah\u5c0f\u843d\u3002</p> \u522b\u79f0 \u5173\u8054\u5927\u4e8b\u4ef6 \u8001\u73ed\u3001\u73ed\u73ed\u3001\u73ed\u957f XHwiki\u3001\u7ed9\u4f60\u6237\u5f00\u4e86\u3001\u9505\u91d1\u9c7c\u98df\u4e43\u9f99\u3001\u9b54~\u672f~\u6280~\u5de7~\u3001\u6211\u5c06 \u8a93\u6b7b\u634d\u536b \u6211\u7684 \u5218\u6d77\u3001\u5e0c\u671b\u6709\u7fbd\u6bdb\u548c\u7fc5\u8180\u30015.28\u4e16\u754c\u4e0a\u4f1a\u6709\u4e00\u4e2a\u975e\u5e38\u975e\u5e38\u5e78\u798f\u7684\u5973\u5b69"},{"location":"Students/25/#_3","title":"\u4f60\u77e5\u9053\u7684\u592a\u591a\u4e86","text":"<p>\u6700\u559c\u6b22\u7684\u989c\u8272\uff1a\u5929\u84dd</p> <p>\u559c\u6b22\u7684\u6b4c\u624b\uff1a\u6797\u4fca\u6770\u3001\u674e\u8363\u6d69\u3001\u6768\u4e1e\u7433\u3001\u90d1\u6da6\u6cfd\u3001\u989c\u4eba\u4e2d\u3001\u5468\u6770\u4f26\u3001\u90ed\u9759\u3001Bsh-1</p> <p>\u559c\u6b22\u7684\u98df\u7269\uff1a\u9178\u6c64\u80a5\u725b\u3001\u8212\u8299\u857e\u3001\u62b9\u8336\u7684\u4e00\u5207(\u7ea2\u8c46\u6765\u8005\u4e0d\u62d2)\u3001\u70b8\u9e21(\u521a\u51fa\u7089\u7684)</p> <p>\u559c\u6b22\u7684\u6e38\u620f\uff1a\u738b\u8005\u8363\u8000\u3001\u4e09\u89d2\u6d32\u884c\u52a8\u3001\u65e0\u754f\u5951\u7ea6\u3001\u539f\u795e\u5d29\u94c1\u7edd\u533a\u96f6\u3001\u5b9e\u51b5\u8db3\u7403</p> <p>\u559c\u6b22\u7684\u6f14\u5458\uff1a\u5305\u4e0a\u6069</p> <p>\u559c\u6b22\u770b\u7684\u756a\uff1a\u51b0\u83d3</p> <p>\u6700\u559c\u6b22\u7684\u4e00\u53e5\u6b4c\u8bcd\uff1a\u8f7b\u5f39\u4e00\u9996\u522b\u79bb \u540d\u4e3a\u8309\u8389\u96e8</p> <p>\u672a\u6765\u804c\u4e1a\uff1f\uff1a\u8001\u5e08\u3001\u7a0b\u5e8f\u5458\u3001\u521b\u4e1a\uff1f</p> <p>\u64c5\u957f\u7684\u5b66\u79d1\uff1a\u65e0</p> <p>\u4e0d\u64c5\u957f\u7684\u5b66\u79d1\uff1a\u8bed\u6587\u3001\u6570\u5b66\u3001\u82f1\u8bed\u3001\u653f\u6cbb\u3001\u5386\u53f2\u3001\u7269\u7406\u3001\u5316\u5b66\u3001\u751f\u7269\u3001\u5730\u7406\u3001\u4f53\u80b2\u3001\u7f8e\u672f\u3001\u97f3\u4e50\u3001\u4fe1\u606f</p> <p>\u8003\u8bd5\u8003\u597d\u7684\u79d8\u8bc0\uff1a0%\u7684\u52aa\u529b\uff0c0.01%\u7684\u5929\u8d4b\uff0c99.99%\u7684\u53d1\u6325+\u8fd0\u6c14</p> <p>\u6700\u559c\u6b22\u7684\u8001\u5e08\uff1a</p> <p>Top1-\u8bed\u6587\u6234\u4e3d\u8389</p> <p>Top2-\u7269\u7406\u5434\u8d75 </p> <p>Top3-\u6570\u5b66\u6c6a\u5c9a/\u751f\u7269\u989c\u627f\u7950/\u4fe1\u606f\u6bb7\u5764/\u4f53\u80b2\u5f20\u5f6a(\u4e0d\u77e5\u9053\u8fd9\u56db\u4e2a\u600e\u4e48\u6392\uff0c\u5c31\u5f53\u5e76\u5217\u770b\u5427)</p> <p>\u91d1\u4ed5\u6770\u6709\u4e00\u4e2a\u4eb2\u5f1f\u5f1f\uff0c\u53eb\u505a\u91d1\u4ee1\u6770\u3002</p>"},{"location":"Students/25/#_4","title":"\u73ed\u957f","text":"<p>\u56e0\u4e3a\u91d1\u4ed5\u6770\u7684\u6027\u683c\u662f\u6162\u70ed\u7684\uff0c\u6240\u4ee5\u521a\u5f00\u5b66\u7684\u519b\u8bad\u4ed6\u8868\u73b0\u975e\u5e38\u597d\uff0c\u51e0\u4e4e\u4e0d\u600e\u4e48\u8bb2\u8bdd\uff0c\u4f46\u662f\u8fd9\u5176\u5b9e\u53ea\u662f\u56e0\u4e3a\u4ed6\u6bd4\u8f83\u817c\u8146\u7f62\u4e86\u3002 \u5176\u5b9e\u4e5f\u6709\u4f8b\u5916\uff0c\u6bd4\u5982\u5728\u521a\u5f00\u59cb\u6392\u961f\u7684\u65f6\u5019\uff0c\u770b\u5230\u91d1\u6cfd\u9716\u548c\u5362\u6da6\u5764\u4e00\u76f4\u5728\u7b11\uff0c\u4e8e\u662f\u5927\u80c6\u6311\u6218\u8ddf\u91d1\u6cfd\u9716\u5bf9\u89c6\u4e94\u79d2\uff0c\u7ed3\u679c\u6ca1\u7ef7\u4f4f\u3002</p> <p>\u6b63\u56e0\u4e3a\u5728\u519b\u8bad\u65f6\u4e0d\u9519\u7684\u8868\u73b0\uff0c\u88ab\u6234\u8001\u5e08\u9009\u4e3a\u4e86\u521d\u4e00\u4e8c\u73ed\u7684\u73ed\u957f(\u540c\u65f6\u88ab\u9009\u4e0a\u7684\u8fd8\u6709\u5f20\u4e00\u683c)\u3002 \u53ef\u80fd\u7531\u4e8e\u91d1\u4ed5\u6770\u4e0e\u540c\u5b66\u4eec\u6bd4\u8f83\u597d\u6253\u4ea4\u9053\uff0c\u6e10\u6e10\u5730\u540c\u5b66\u4eec\u597d\u50cf\u603b\u662f\u53eb\u91d1\u4ed5\u6770\u8001\u73ed\u6216\u73ed\u957f\u3002 \u540e\u6765\u91d1\u4ed5\u6770\u5f53\u4e0a\u4e86\u4e2d\u961f\u957f\u3002</p> <p>\u8fd9\u79cd\u5931\u53bb\u672c\u540d\u7684\u73b0\u8c61\u4e00\u76f4\u51fa\u73b0\u5230\u521d\u4e00\u4e0b\uff0c\u56e0\u4e3a\u91d1\u4ed5\u6770\u5df2\u7ecf\u62c5\u4efb\u4e86\u4e2d\u961f\u957f\uff0c\u6240\u4ee5\u5728\u7ecf\u8fc7\u601d\u8003\u540e\u9009\u62e9\u653e\u5f03\u73ed\u957f\u7684\u804c\u52a1(\u8fd9\u4e2a\u5176\u5b9e\u662f\u6709\u539f\u56e0\u7684\uff0c\u4f46\u662f\u4f60\u77e5\u9053\u7684\u592a\u591a\u4e86)\u3002 \u5728\u91d1\u4ed5\u6770\u5df2\u7ecf\u4e0d\u662f\u73ed\u957f\u4e4b\u540e\uff0c\u4e00\u4e9b\u540c\u5b66\u597d\u50cf\u8fd8\u662f\u66f4\u613f\u610f\u53eb\u4ed6\u73ed\u957f\u3002</p> <p></p>"},{"location":"Students/25/#_5","title":"\u8054\u7cfb\u65b9\u5f0f","text":"<ul> <li>\u624b\u673a\u53f7\uff1a15996419387</li> <li>\u5fae\u4fe1\uff1aLuoahzzz</li> <li>\u90ae\u7bb1\uff1a3385531450@qq.com</li> <li>GitHub\uff1a@Luoah-ivy</li> </ul>"},{"location":"Students/29/","title":"\u5362\u6da6\u5764","text":"<p>show off\u5927\u738b\u3002\u9178\u81ed\u3002</p> <p>\u5362\u6da6\u5764(20250229)\uff0c\u6635\u79f0\uff1a\u4f60\u4e0d\u9700\u8981\u77e5\u9053\u3002</p>"},{"location":"Students/29/#_2","title":"\u9178\u81ed","text":""},{"location":"Students/29/#_3","title":"\u55e6\u7c89\u5566","text":""},{"location":"Students/29/#_4","title":"\u4f9d\u65e7\u87ba\u86f3\u7c89\u4ee3\u8a00\u4eba","text":"<p>\u56e0\u4e3a\u6211\u77e5\u9053\u9178\u81ed\u7684\u5362\u6da6\u5764\u80af\u5b9a\u5e0c\u671b\u81ea\u5df1\u7684\u7b80\u4ecb\u8db3\u591f\u9178\u81ed\uff0c\u6240\u4ee5\u6211\u5565\u4e5f\u4e0d\u5199\uff0c\u76f4\u63a5\u7ed9\u4f60\u6025\u54ed\u3002</p>"}]}