{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6b22\u8fce\u6765\u5230\u661f\u6d77wiki\uff01","text":""},{"location":"Home/introduction/","title":"\u6b22\u8fce\u6765\u5230\u661f\u6d77wiki\uff01","text":"<p>XHwiki\uff0c\u5373\u661f\u6d77wiki\uff0c\u662f\u7531Luoah\u5236\u4f5c\u7684wiki\u7f51\u7ad9\u3002 \u8fd9\u91cc\u6536\u5f55\u5357\u4eac\u90d1\u548c\u5916\u56fd\u8bed\u5b66\u6821\u661f\u6d77\u73ed(\u53732025\u7ea72\u73ed)\u7684\u5404\u79cd\u6897\u77e5\u8bc6\u3001\u4eba\u7269\u3001 \u4ee5\u53ca\u5404\u79cd\u8bed\u5f55\u2026\u2026</p>"},{"location":"Home/introduction/#_1","title":"\u5236\u4f5c\u56e2\u961f","text":"<p>\u4ee3\u7801\uff1aLuoah</p> <p>\u6587\u672c\uff1aLuoah</p> <p>\u7f8e\u5de5\uff1aLuoah</p> <p>\u8fd0\u8425\uff1aLuoah</p> <p>\u53d1\u884c\uff1aLuoah</p> <p>\u5ba3\u4f20\uff1aLuoah</p> <p>\u601d\u8def\uff1aLuoah</p> <p>Luoah\u771f\u662f\u592a\u5f3a\u4e86\uff01</p>"},{"location":"Home/introduction/#_2","title":"\u8054\u7cfb\u6211\u4eec","text":"<p>\u5982\u679c\u60a8\u6709\u5408\u7406\u7684\u610f\u89c1\uff0c\u6211\u4eec\u975e\u5e38\u6b22\u8fce\u60a8\u4e3a\u6211\u4eecXHwiki\u7684\u53d1\u5c55\u5efa\u8a00\u732e\u7b56\u3002</p> <p>\u5f53\u7136\uff0c\u60a8\u4e5f\u53ef\u4ee5\u5927\u80c6\u63d0\u51fa\u4e0d\u5408\u7406\u7684\u95ee\u9898\uff0c\u8fd9\u6837\u60a8\u5c31\u53ef\u4ee5\u51fa\u73b0\u5728Luoah\u7684\u9ed1\u540d\u5355\u4e2d\u540d\u5782\u6d45\u5c4e\uff0c\u5e76\u4e14Luoah\u4e5f\u4e0d\u4f1a\u6539\u3002</p> <p>\u5982\u679c\u60a8\u63d0\u51fa\u7684\u610f\u89c1\u8db3\u591f\u6709\u4ef7\u503c\u3001\u6709\u610f\u4e49\uff0c\u6211\u4eec\u7684\u56e2\u961f\u5c06\u975e\u5e38\u6b22\u8fce\u60a8\u7684\u52a0\u5165\uff01</p> <p></p> <p>\u9644\uff1a\u82e5\u8981\u8054\u7cfbLuoah\uff0c\u8bf7\u6253\u5f00\u91d1\u4ed5\u6770\u7684\u4ecb\u7ecd\u67e5\u770bLuoah\u7684\u8054\u7cfb\u65b9\u5f0f\u3002</p>"},{"location":"Home/introduction/#_3","title":"\u81f4\u8c22","text":"<p>\u611f\u8c22Henson\u63d0\u4f9b\u90e8\u5206\u7075\u611f\u4e0e\u601d\u8def\u652f\u6301\u3002</p> <p>\u611f\u8c22Henson\u3001Milson\u3001\u54cd\u5f7b\u672a\u6765\u3001Goldenfish\u53c2\u4e0e\u516c\u6d4b\u5e76\u63d0\u4f9b\u610f\u89c1\u3002</p> <p>\u611f\u8c22lris\u5728\u6211\u7684\u521b\u4f5c\u9014\u4e2d\u7ed9\u4e88\u6211\u7684\u6fc0\u52b1\u4e0e\u652f\u6301\u3002</p> <p>\u611f\u8c22Bilibili 8047-\u7684\u6559\u5b66\u3002</p> <p>\u611f\u8c22Github\u63d0\u4f9b\u7684\u4e91\u5b58\u50a8\u4e0e\u670d\u52a1\u5668\u652f\u6301\u3002</p> <p>\u611f\u8c22mkdocs\u7684wiki\u6a21\u677f\u3002</p>"},{"location":"Students/25/","title":"\u91d1\u4ed5\u6770","text":""},{"location":"Students/25/#_2","title":"\u7b80\u4ecb","text":"<p>\u91d1\u4ed5\u6770(20250225)\uff0c\u6635\u79f0Luoah\u5c0f\u843d\u3002</p> \u522b\u79f0 \u5173\u8054\u5927\u4e8b\u4ef6 \u8001\u73ed\u3001\u73ed\u73ed\u3001\u73ed\u957f XHwiki\u3001\u7ed9\u4f60\u6237\u5f00\u4e86\u3001\u9505\u91d1\u9c7c\u98df\u4e43\u9f99\u3001\u9b54~\u672f~\u6280~\u5de7~\u3001\u6211\u5c06 \u8a93\u6b7b\u634d\u536b \u6211\u7684 \u5218\u6d77\u3001\u5e0c\u671b\u6709\u7fbd\u6bdb\u548c\u7fc5\u8180\u30015.28\u4e16\u754c\u4e0a\u4f1a\u6709\u4e00\u4e2a\u975e\u5e38\u5e78\u798f\u7684\u5973\u5b69"},{"location":"Students/25/#_3","title":"\u4f60\u77e5\u9053\u7684\u592a\u591a\u4e86","text":"<p>\u6700\u559c\u6b22\u7684\u989c\u8272\uff1a\u5929\u84dd</p> <p>\u559c\u6b22\u7684\u6b4c\u624b\uff1a\u6797\u4fca\u6770\u3001\u674e\u8363\u6d69\u3001\u6768\u4e1e\u7433\u3001\u90d1\u6da6\u6cfd\u3001\u989c\u4eba\u4e2d\u3001\u5468\u6770\u4f26\u3001\u90ed\u9759\u3001Bsh-1</p> <p>\u559c\u6b22\u7684\u98df\u7269\uff1a\u9178\u6c64\u80a5\u725b\u3001\u8212\u8299\u857e\u3001\u62b9\u8336\u7684\u4e00\u5207(\u7ea2\u8c46\u6765\u8005\u4e0d\u62d2)\u3001\u70b8\u9e21(\u521a\u51fa\u7089\u7684)</p> <p>\u559c\u6b22\u7684\u6e38\u620f\uff1a\u738b\u8005\u8363\u8000\u3001\u4e09\u89d2\u6d32\u884c\u52a8\u3001\u65e0\u754f\u5951\u7ea6\u3001\u539f\u795e\u5d29\u94c1\u7edd\u533a\u96f6\u3001\u5b9e\u51b5\u8db3\u7403</p> <p>\u559c\u6b22\u7684\u6f14\u5458\uff1a\u5305\u4e0a\u6069</p> <p>\u559c\u6b22\u770b\u7684\u756a\uff1a\u51b0\u83d3</p> <p>\u6700\u559c\u6b22\u7684\u4e00\u53e5\u6b4c\u8bcd\uff1a\u8f7b\u5f39\u4e00\u9996\u522b\u79bb \u540d\u4e3a\u8309\u8389\u96e8</p> <p>\u672a\u6765\u804c\u4e1a\uff1f\uff1a\u8001\u5e08\u3001\u7a0b\u5e8f\u5458\u3001\u521b\u4e1a\uff1f</p> <p>\u64c5\u957f\u7684\u5b66\u79d1\uff1a\u65e0</p> <p>\u4e0d\u64c5\u957f\u7684\u5b66\u79d1\uff1a\u8bed\u6587\u3001\u6570\u5b66\u3001\u82f1\u8bed\u3001\u653f\u6cbb\u3001\u5386\u53f2\u3001\u7269\u7406\u3001\u5316\u5b66\u3001\u751f\u7269\u3001\u5730\u7406\u3001\u4f53\u80b2\u3001\u7f8e\u672f\u3001\u97f3\u4e50\u3001\u4fe1\u606f</p> <p>\u8003\u8bd5\u8003\u597d\u7684\u79d8\u8bc0\uff1a0%\u7684\u52aa\u529b\uff0c0.01%\u7684\u5929\u8d4b\uff0c99.99%\u7684\u53d1\u6325+\u8fd0\u6c14</p> <p>\u6700\u559c\u6b22\u7684\u8001\u5e08\uff1a</p> <p>Top1-\u8bed\u6587\u6234\u4e3d\u8389</p> <p>Top2-\u7269\u7406\u5434\u8d75 </p> <p>Top3-\u6570\u5b66\u6c6a\u5c9a/\u751f\u7269\u989c\u627f\u7950/\u4fe1\u606f\u6bb7\u5764(\u4e0d\u77e5\u9053\u8fd9\u4e09\u4e2a\u600e\u4e48\u6392\uff0c\u5c31\u5f53\u5e76\u5217\u770b\u5427)</p> <p>\u91d1\u4ed5\u6770\u6709\u4e00\u4e2a\u4eb2\u5f1f\u5f1f\uff0c\u53eb\u505a\u91d1\u4ee1\u6770\u3002</p>"},{"location":"Students/25/#_4","title":"\u73ed\u957f","text":"<p>\u56e0\u4e3a\u91d1\u4ed5\u6770\u7684\u6027\u683c\u662f\u6162\u70ed\u7684\uff0c\u6240\u4ee5\u521a\u5f00\u5b66\u7684\u519b\u8bad\u4ed6\u8868\u73b0\u975e\u5e38\u597d\uff0c\u51e0\u4e4e\u4e0d\u600e\u4e48\u8bb2\u8bdd\uff0c\u4f46\u662f\u8fd9\u5176\u5b9e\u53ea\u662f\u56e0\u4e3a\u4ed6\u6bd4\u8f83\u817c\u8146\u7f62\u4e86\u3002 \u5176\u5b9e\u4e5f\u6709\u4f8b\u5916\uff0c\u6bd4\u5982\u5728\u521a\u5f00\u59cb\u6392\u961f\u7684\u65f6\u5019\uff0c\u770b\u5230\u91d1\u6cfd\u9716\u548c\u5362\u6da6\u5764\u4e00\u76f4\u5728\u7b11\uff0c\u4e8e\u662f\u5927\u80c6\u6311\u6218\u8ddf\u91d1\u6cfd\u9716\u5bf9\u89c6\u4e94\u79d2\uff0c\u7ed3\u679c\u6ca1\u7ef7\u4f4f\u3002</p> <p>\u6b63\u56e0\u4e3a\u5728\u519b\u8bad\u65f6\u4e0d\u9519\u7684\u8868\u73b0\uff0c\u88ab\u6234\u8001\u5e08\u9009\u4e3a\u4e86\u521d\u4e00\u4e8c\u73ed\u7684\u73ed\u957f(\u540c\u65f6\u88ab\u9009\u4e0a\u7684\u8fd8\u6709\u5f20\u4e00\u683c)\u3002 \u53ef\u80fd\u7531\u4e8e\u91d1\u4ed5\u6770\u4e0e\u540c\u5b66\u4eec\u6bd4\u8f83\u597d\u6253\u4ea4\u9053\uff0c\u6e10\u6e10\u5730\u540c\u5b66\u4eec\u597d\u50cf\u603b\u662f\u53eb\u91d1\u4ed5\u6770\u8001\u73ed\u6216\u73ed\u957f\u3002 \u540e\u6765\u91d1\u4ed5\u6770\u5f53\u4e0a\u4e86\u4e2d\u961f\u957f\u3002</p> <p>\u8fd9\u79cd\u5931\u53bb\u672c\u540d\u7684\u73b0\u8c61\u4e00\u76f4\u51fa\u73b0\u5230\u521d\u4e00\u4e0b\uff0c\u56e0\u4e3a\u91d1\u4ed5\u6770\u5df2\u7ecf\u62c5\u4efb\u4e86\u4e2d\u961f\u957f\uff0c\u6240\u4ee5\u5728\u7ecf\u8fc7\u601d\u8003\u540e\u9009\u62e9\u653e\u5f03\u73ed\u957f\u7684\u804c\u52a1(\u8fd9\u4e2a\u5176\u5b9e\u662f\u6709\u539f\u56e0\u7684\uff0c\u4f46\u662f\u4f60\u77e5\u9053\u7684\u592a\u591a\u4e86)\u3002 \u5728\u91d1\u4ed5\u6770\u5df2\u7ecf\u4e0d\u662f\u73ed\u957f\u4e4b\u540e\uff0c\u4e00\u4e9b\u540c\u5b66\u597d\u50cf\u8fd8\u662f\u66f4\u613f\u610f\u53eb\u4ed6\u73ed\u957f\u3002</p> <p></p>"},{"location":"Students/25/#_5","title":"\u8054\u7cfb\u65b9\u5f0f","text":"<ul> <li>\u624b\u673a\u53f7\uff1a15996419387</li> <li>\u5fae\u4fe1\uff1aLuoahzzz</li> <li>\u90ae\u7bb1\uff1a3385531450@qq.com</li> <li>GitHub\uff1a@Luoah-ivy</li> </ul>"},{"location":"Students/29/","title":"\u5362\u6da6\u5764","text":"<p>\u5362\u6da6\u5764(20250229)\uff0c\u6635\u79f0\uff1a\u4f60\u4e0d\u9700\u8981\u77e5\u9053\u3002</p>"},{"location":"Students/29/#_2","title":"\u9178\u81ed","text":""},{"location":"Students/29/#_3","title":"\u55e6\u7c89\u5566","text":""},{"location":"Students/29/#_4","title":"\u4f9d\u65e7\u87ba\u86f3\u7c89\u4ee3\u8a00\u4eba","text":"<p>\u56e0\u4e3a\u6211\u77e5\u9053\u9178\u81ed\u7684\u5362\u6da6\u5764\u80af\u5b9a\u5e0c\u671b\u81ea\u5df1\u7684\u7b80\u4ecb\u8db3\u591f\u9178\u81ed\uff0c\u6240\u4ee5\u6211\u5565\u4e5f\u4e0d\u5199\uff0c\u76f4\u63a5\u7ed9\u4f60\u6025\u54ed\u3002</p>"}]}